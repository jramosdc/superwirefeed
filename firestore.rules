rules_version = '2';

// SuperWire Firestore security rules. The original app shipped with NO rules;
// this closes those holes. Listings are world-readable; writes are owner-scoped;
// purchases can only be written server-side (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Users: anyone can read a public profile; only the owner can write theirs.
    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if isOwner(uid);

      // Follow graph subcollections — only the owning user mutates their side.
      match /following/{targetId} {
        allow read: if true;
        allow write: if isOwner(uid);
      }
      match /followers/{followerId} {
        allow read: if true;
        // The follower writes into the target's followers list (their own uid).
        allow write: if isOwner(followerId);
      }
    }

    // Feeds: world-readable; one feed per user, writable only by that user.
    match /feeds/{feedId} {
      allow read: if true;
      allow create, update, delete: if isOwner(feedId);
    }

    // Posts: world-readable. Only the owner may create/edit/delete, and the
    // ownerUid/feedId must match the caller.
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.feedId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Purchases: a user may read only their own. NO client writes — the Stripe
    // webhook writes these via the Admin SDK (which bypasses rules).
    match /purchases/{purchaseId} {
      // `resource` is null when the doc doesn't exist (the common "have I bought
      // this?" check) — allow that so the get returns empty instead of erroring.
      allow read: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Download history: a user may read only their own. NO client writes —
    // the /api/download route records them via the Admin SDK.
    match /downloads/{downloadId} {
      allow read: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Subscriptions: a user may read only their own. NO client writes — the
    // Stripe webhook writes these via the Admin SDK (which bypasses rules).
    match /subscriptions/{subId} {
      // `resource` is null when the doc doesn't exist (the common "am I
      // subscribed?" check) — allow that so the get returns empty.
      allow read: if signedIn()
        && (resource == null || resource.data.subscriberUid == request.auth.uid);
      allow write: if false;
    }

    // Reviews: world-readable. Written ONLY by the server (/api/reviews via the
    // Admin SDK) so the seller's rating aggregate stays consistent. Clients
    // cannot write directly.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Accuracy attestations, the per-post accuracy aggregate, and member trust
    // scores are world-readable but written ONLY by the server (/api/attestations
    // via the Admin SDK). This is what makes the trust signal forgery-proof — a
    // member can't write their own trust or fake an aggregate.
    match /attestations/{attestationId} {
      allow read: if true;
      allow write: if false;
    }
    match /postAccuracy/{postId} {
      allow read: if true;
      allow write: if false;
    }
    match /trust/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Human certifications + AI flags: world-readable, written ONLY by the
    // server (/api/certify, /api/moderate) which enforces third-party + role
    // (trust-tier) checks. Clients can't self-certify or self-flag.
    match /certifications/{certId} {
      allow read: if true;
      allow write: if false;
    }
    match /postCertification/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Usage counters (views/purchases/downloads) — read-public, written only by
    // the server (/api/view, webhook, download route) so they can't be inflated.
    match /postStats/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Requests/bounties: world-readable. A requester owns their request (and may
    // close it / mark it fulfilled); a responder owns their response.
    match /requests/{requestId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.requesterUid == request.auth.uid;
    }
    match /requestResponses/{responseId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.responderUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.responderUid == request.auth.uid;
    }

    // Post secrets: the seller-private side of a post — the external
    // deliverable link (Drive/WeTransfer/…). Post docs are world-readable, so
    // the URL must live here instead; buyers get it via the purchase-gated
    // /api/download route (Admin SDK bypasses these rules). Only the post's
    // owner may read or write, and create checks the POST's ownerUid so
    // nobody can squat a secret onto someone else's post.
    match /postSecrets/{postId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(postId)).data.ownerUid
             == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Share events (growth loop): create-only. A client may record that THEY
    // shared something; nobody can read, edit, or delete share events (they
    // feed the server-side waiver-credit economy, so they must be untamperable
    // after the fact). Matches the write the iOS client already attempts.
    match /shares/{shareId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.sharerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Fee-waiver credits: a user may read only their own (the iOS Rewards
    // screen queries `where uid == auth.uid`). NO client writes — credits are
    // granted/consumed only by the server (/api/shares + the Stripe webhook).
    match /waiverCredits/{creditId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Transactions ledger — the source of truth for what sellers are owed.
    // A seller may read their own sales; written ONLY by the Stripe webhook.
    match /transactions/{txId} {
      allow read: if signedIn() && resource.data.sellerUid == request.auth.uid;
      allow write: if false;
    }

    // Payouts — money actually sent to a seller, recorded by the owner via the
    // Admin SDK. A seller may read their own; NO client writes.
    match /payouts/{payoutId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // FCM device tokens (push notifications). Keyed by token; a user may
    // register/replace/remove only their own device docs and read only their
    // own. Sending happens exclusively server-side (/api/notify-followers).
    match /fcmTokens/{token} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Per-post notification marker: one push blast per post, written ONLY by
    // /api/notify-followers (Admin SDK). The post's owner may read theirs
    // (drives "already notified" UI); doubles as the future billing record.
    match /postNotifications/{postId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Comments: comments/{postId}/items/{id}
    match /comments/{postId}/items/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
