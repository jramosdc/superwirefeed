# ---- Firebase Web SDK (client) ----
# From the Firebase console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only) ----
# From a service-account JSON. Keep the private key on one line with literal \n escapes.
# REQUIRED ON VERCEL: set all three (client email + private key + project id) —
# without them every API route fails auth with a 401.
# Local alternative: leave email/key empty and point
# GOOGLE_APPLICATION_CREDENTIALS at the service-account JSON file instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Shared secret for Vercel Cron routes (vercel.json). Vercel sends it as
# `Authorization: Bearer <value>`; the route refuses to run without it.
CRON_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- App ----
# Public base URL, used for Stripe success/cancel redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Emulators (dev only) ----
# Set to "1" to point the client + admin SDKs at the local Firebase emulator suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
